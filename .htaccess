# Chặn truy cập trực tiếp file nhạy cảm và dotfile
<FilesMatch "(^\.|\.(sql|md|log|ini|bak|sh|py)$|^config.*\.php$)">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Deny from all
  </IfModule>
</FilesMatch>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Chặn truy cập trực tiếp các thư mục nội bộ
  RewriteRule ^(\.git|app|storage|database|themes|tests|design) - [F,L]

  # Chuyển tiếp toàn bộ request vào thư mục public/
  RewriteCond %{REQUEST_URI} !^/public/
  RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
