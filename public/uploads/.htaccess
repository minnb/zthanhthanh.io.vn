# Thư mục upload: chỉ phục vụ file tĩnh, không bao giờ chạy script
Options -Indexes -ExecCGI
RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .phar
RemoveType .php .phtml .phar
<FilesMatch "\.(php|phtml|phar|php\d)$">
  Require all denied
</FilesMatch>
<IfModule mod_php.c>
  php_flag engine off
</IfModule>
